rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validConversationAppearance(appearance, uid) {
      return appearance is map
        && appearance.keys().hasOnly([
          'theme', 'background', 'fontSize', 'bubbleStyle',
          'wallpaperURL', 'wallpaperPath', 'wallpaperId',
          'wallpaperMotion', 'sentBubbleColor', 'receivedBubbleColor',
          'brightness', 'bubbleOpacity'
        ])
        && appearance.theme in ['midnight', 'ocean', 'light', 'pulse-blue', 'amoled']
        && appearance.background in ['plain', 'gradient', 'dots']
        && appearance.fontSize in ['small', 'medium', 'large']
        && appearance.bubbleStyle in [
          'rounded', 'soft', 'square', 'compact',
          'whatsapp', 'messenger', 'pill', 'minimal'
        ]
        && (
          !appearance.keys().hasAny(['wallpaperId'])
          || appearance.wallpaperId in [
            'none', 'minimal', 'doodle', 'nature-ocean',
            'nature-forest', 'nature-mountains', 'nature-sunset', 'aurora'
          ]
        )
        && (
          !appearance.keys().hasAny(['wallpaperMotion'])
          || appearance.wallpaperMotion in ['none', 'aurora', 'flow']
        )
        && (
          !appearance.keys().hasAny(['sentBubbleColor'])
          || (
            appearance.sentBubbleColor is string
            && appearance.sentBubbleColor.matches('^#[0-9A-Fa-f]{6}$')
          )
        )
        && (
          !appearance.keys().hasAny(['receivedBubbleColor'])
          || (
            appearance.receivedBubbleColor is string
            && appearance.receivedBubbleColor.matches('^#[0-9A-Fa-f]{6}$')
          )
        )
        && (
          !appearance.keys().hasAny(['brightness'])
          || (
            appearance.brightness is int
            && appearance.brightness >= 0
            && appearance.brightness <= 100
          )
        )
        && (
          !appearance.keys().hasAny(['bubbleOpacity'])
          || (
            appearance.bubbleOpacity is int
            && appearance.bubbleOpacity >= 50
            && appearance.bubbleOpacity <= 100
          )
        )
        && (
          !appearance.keys().hasAny(['wallpaperURL', 'wallpaperPath'])
          || (
            appearance.wallpaperURL == null
            && appearance.wallpaperPath == null
          )
          || (
            appearance.wallpaperURL is string
            && appearance.wallpaperURL.size() <= 2048
            && appearance.wallpaperURL.matches(
              '^https://firebasestorage[.]googleapis[.]com/.*$'
            )
            && appearance.wallpaperPath is string
            && appearance.wallpaperPath.size() <= 512
            && appearance.wallpaperPath.matches(
              '^conversationWallpapers/' + uid + '/[A-Za-z0-9._/-]+$'
            )
          )
        );
    }

    function isFollowedByViewer(uid) {
      return signedIn()
        && exists(
          /databases/$(database)/documents/followRelationships/$(request.auth.uid + '_' + uid)
        );
    }

    function followsViewer(uid) {
      return signedIn()
        && exists(
          /databases/$(database)/documents/followRelationships/$(uid + '_' + request.auth.uid)
        );
    }

    function isParticipant(conversationId) {
      return signedIn()
        && exists(/databases/$(database)/documents/conversations/$(conversationId))
        && request.auth.uid in get(
          /databases/$(database)/documents/conversations/$(conversationId)
        ).data.participants;
    }


    // Public directory contains only information intended for discovery.
    // Private email addresses and phone numbers belong in users/{uid}.
    match /publicProfiles/{uid} {
      allow read: if signedIn()
        && (
          resource.data.discoverable == true
          || isOwner(uid)
          || isFollowedByViewer(uid)
          || followsViewer(uid)
        );

      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.discoverable is bool
        && request.resource.data.displayName is string
        && request.resource.data.username is string
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'username', 'photoURL',
          'bio', 'discoverable', 'createdAt', 'updatedAt'
        ]);

      allow update: if isOwner(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.discoverable is bool
        && request.resource.data.displayName is string
        && request.resource.data.username is string
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'username', 'photoURL',
          'bio', 'discoverable', 'createdAt', 'updatedAt'
        ]);

      allow delete: if isOwner(uid);
    }

    // Private account information is accessible only to its owner.
    match /users/{uid} {
      allow read, create, update, delete: if isOwner(uid);

      match /following/{targetUid} {
        allow read: if isOwner(uid);

        allow create: if isOwner(uid)
          && targetUid != uid
          && request.resource.data.targetUid == targetUid
          && request.resource.data.keys().hasOnly([
            'targetUid', 'createdAt'
          ])
          && exists(
            /databases/$(database)/documents/publicProfiles/$(targetUid)
          )
          && get(
            /databases/$(database)/documents/publicProfiles/$(targetUid)
          ).data.discoverable == true;

        allow delete: if isOwner(uid);
        allow update: if false;
      }

      // Per-member inbox preferences never modify shared conversations.
      match /conversationPreferences/{conversationId} {
        allow read: if isOwner(uid);

        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly([
            'pinned', 'pinnedMessageIds', 'lastReadAt', 'updatedAt', 'appearance'
          ])
          && (
            !request.resource.data.keys().hasAny(['pinned'])
            || request.resource.data.pinned is bool
          )
          && (
            !request.resource.data.keys().hasAny(['pinnedMessageIds'])
            || (
              request.resource.data.pinnedMessageIds is list
              && request.resource.data.pinnedMessageIds.size() <= 100
            )
          )
          && (
            !request.resource.data.keys().hasAny(['lastReadAt'])
            || request.resource.data.lastReadAt is timestamp
          )
          && (
            !request.resource.data.keys().hasAny(['updatedAt'])
            || request.resource.data.updatedAt is timestamp
          )
          && (
            !request.resource.data.keys().hasAny(['appearance'])
            || validConversationAppearance(request.resource.data.appearance, uid)
          );

        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'pinned', 'pinnedMessageIds', 'lastReadAt', 'updatedAt', 'appearance'
          ])
          && (
            !request.resource.data.keys().hasAny(['pinned'])
            || request.resource.data.pinned is bool
          )
          && (
            !request.resource.data.keys().hasAny(['pinnedMessageIds'])
            || (
              request.resource.data.pinnedMessageIds is list
              && request.resource.data.pinnedMessageIds.size() <= 100
            )
          )
          && (
            !request.resource.data.keys().hasAny(['lastReadAt'])
            || request.resource.data.lastReadAt is timestamp
          )
          && (
            !request.resource.data.keys().hasAny(['updatedAt'])
            || request.resource.data.updatedAt is timestamp
          )
          && (
            !request.resource.data.keys().hasAny(['appearance'])
            || validConversationAppearance(request.resource.data.appearance, uid)
          );

        allow delete: if isOwner(uid);
      }

      match /devices/{deviceId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Follow relationships are visible only to their two participants.
    // The follower can create or remove their own relationship.
    match /followRelationships/{relationshipId} {
      allow read: if signedIn()
        && (
          request.auth.uid == resource.data.followerUid
          || request.auth.uid == resource.data.followingUid
        );

      allow create: if signedIn()
        && request.resource.data.followerUid == request.auth.uid
        && request.resource.data.followingUid is string
        && request.resource.data.followingUid != request.auth.uid
        && relationshipId == request.auth.uid + '_' + request.resource.data.followingUid
        && request.resource.data.keys().hasOnly([
          'followerUid', 'followingUid', 'createdAt'
        ])
        && exists(
          /databases/$(database)/documents/publicProfiles/$(request.resource.data.followingUid)
        )
        && get(
          /databases/$(database)/documents/publicProfiles/$(request.resource.data.followingUid)
        ).data.discoverable == true;

      allow delete: if signedIn()
        && request.auth.uid == resource.data.followerUid;

      allow update: if false;
    }

    // A direct conversation has exactly two authenticated participants.
    match /conversations/{conversationId} {
      // A first-time direct conversation must be readable as missing
      // during the transaction that creates it.
      allow get: if signedIn()
        && (
          resource == null
          || request.auth.uid in resource.data.participants
        );

      // Collection queries remain restricted to actual participants.
      allow list: if signedIn()
        && request.auth.uid in resource.data.participants;

      allow create: if signedIn()
        && request.resource.data.type == 'direct'
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.keys().hasOnly([
          'participants', 'type', 'createdAt', 'updatedAt'
        ]);

      // Conversation metadata updates will be handled by trusted backend
      // functions in a later milestone.
      allow update, delete: if false;

      match /messages/{messageId} {
        allow read: if isParticipant(conversationId);

        allow create: if isParticipant(conversationId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.type in ['text', 'image', 'video', 'document']
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 5000
          && (
            request.resource.data.type != 'text'
            || request.resource.data.text.size() > 0
          )
          && (
            request.resource.data.type == 'text'
            || (
              request.resource.data.attachmentURL is string
              && request.resource.data.attachmentURL.size() > 0
              && request.resource.data.attachmentName is string
              && request.resource.data.attachmentName.size() <= 255
              && request.resource.data.attachmentPath is string
              && request.resource.data.attachmentPath.matches(
                'conversationAttachments/' + conversationId + '/'
                + request.auth.uid + '/.*'
              )
              && request.resource.data.attachmentContentType is string
              && request.resource.data.attachmentSize is int
              && request.resource.data.attachmentSize > 0
              && (
                (
                  request.resource.data.type == 'image'
                  && request.resource.data.attachmentContentType.matches('image/.*')
                  && request.resource.data.attachmentSize <= 20 * 1024 * 1024
                )
                || (
                  request.resource.data.type == 'video'
                  && request.resource.data.attachmentContentType.matches('video/.*')
                  && request.resource.data.attachmentSize <= 50 * 1024 * 1024
                )
                || (
                  request.resource.data.type == 'document'
                  && request.resource.data.attachmentContentType in [
                    'application/pdf',
                    'application/msword',
                    'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
                    'application/vnd.ms-excel',
                    'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
                    'text/plain'
                  ]
                  && request.resource.data.attachmentSize <= 20 * 1024 * 1024
                )
              )
            )
          )
          && request.resource.data.keys().hasOnly([
            'senderId', 'text', 'type', 'createdAt',
            'attachmentURL', 'attachmentName', 'attachmentPath',
            'attachmentContentType', 'attachmentSize'
          ]);

        allow update, delete: if false;
      }

      // Each participant can read receipts but write only their own.
      match /readReceipts/{readerUid} {
        allow read: if isParticipant(conversationId);

        allow create, update: if isParticipant(conversationId)
          && request.auth.uid == readerUid
          && request.resource.data.uid == readerUid
          && request.resource.data.lastReadAt is timestamp
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.keys().hasOnly([
            'uid', 'lastReadAt', 'updatedAt'
          ]);

        allow delete: if false;
      }
    }

    // Published posts are visible to authenticated PULSE members.
    // Only the author can create, update or delete their own post.
    match /posts/{postId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorUsername is string
        && request.resource.data.authorPhotoURL is string
        && request.resource.data.caption is string
        && request.resource.data.caption.size() <= 2200
        && request.resource.data.postType in ['text', 'image', 'video']
        && request.resource.data.createdAt is timestamp
        && (
          request.resource.data.expiresAt == null
          || request.resource.data.expiresAt is timestamp
        )
        && (
          (
            request.resource.data.postType == 'text'
            && !request.resource.data.keys().hasAny([
              'mediaURL', 'mediaPath', 'mediaType'
            ])
          )
          || (
            request.resource.data.postType == 'image'
            && request.resource.data.mediaURL is string
            && request.resource.data.mediaURL.size() > 0
            && request.resource.data.mediaPath is string
            && request.resource.data.mediaPath.matches(
              'postMedia/' + request.auth.uid + '/.*'
            )
            && request.resource.data.mediaType is string
            && request.resource.data.mediaType.matches('image/.*')
          )
          || (
            request.resource.data.postType == 'video'
            && request.resource.data.mediaURL is string
            && request.resource.data.mediaURL.size() > 0
            && request.resource.data.mediaPath is string
            && request.resource.data.mediaPath.matches(
              'postMedia/' + request.auth.uid + '/.*'
            )
            && request.resource.data.mediaType is string
            && request.resource.data.mediaType.matches('video/.*')
          )
        )
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'authorName', 'authorUsername', 'authorPhotoURL',
          'caption', 'postType', 'mediaURL', 'mediaPath', 'mediaType',
          'createdAt', 'expiresAt'
        ]);

      // Post editing is not implemented yet. Owners may delete their posts.
      allow update: if false;
      allow delete: if signedIn()
        && resource.data.ownerUid == request.auth.uid;
    }

    // Everything else is denied unless a specific rule is added.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
