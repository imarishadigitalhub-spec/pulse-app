rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /profilePhotos/{uid}/{fileName} {
      allow read: if request.auth != null;

      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');

      allow delete: if request.auth != null
        && request.auth.uid == uid;
    }

    // Conversation attachments: only conversation participants may read.
    // A member may upload only under their own UID in that conversation.
    match /conversationAttachments/{conversationId}/{uid}/{fileName} {
      function isConversationParticipant() {
        return request.auth != null
          && firestore.exists(
            /databases/(default)/documents/conversations/$(conversationId)
          )
          && request.auth.uid in firestore.get(
            /databases/(default)/documents/conversations/$(conversationId)
          ).data.participants;
      }

      allow read: if isConversationParticipant();

      allow create: if isConversationParticipant()
        && request.auth.uid == uid
        && (
          (
            request.resource.contentType.matches('image/.*')
            && request.resource.size <= 20 * 1024 * 1024
          )
          || (
            request.resource.contentType.matches('video/.*')
            && request.resource.size <= 50 * 1024 * 1024
          )
          || (
            request.resource.contentType in [
              'application/pdf',
              'application/msword',
              'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
              'application/vnd.ms-excel',
              'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
              'text/plain'
            ]
            && request.resource.size <= 20 * 1024 * 1024
          )
        );

      allow update: if false;
      allow delete: if isConversationParticipant()
        && request.auth.uid == uid;
    }

    // Post media: the owner uploads and all authenticated members can view.
    match /postMedia/{uid}/{fileName} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.auth.uid == uid
        && (
          (
            request.resource.contentType.matches('image/.*')
            && request.resource.size <= 20 * 1024 * 1024
          )
          || (
            request.resource.contentType.matches('video/.*')
            && request.resource.size <= 100 * 1024 * 1024
          )
        );

      allow update: if false;
      allow delete: if request.auth != null
        && request.auth.uid == uid;
    }

    // All other storage locations remain denied.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
